# 服务仅允许绑定 loopback。
RADAR_HOST=127.0.0.1
RADAR_PORT=3210
RADAR_DATA_DIR=./data
RADAR_TIMEZONE=Asia/Shanghai

# 仅测试/CI 使用。只有精确设为 1 才禁用全部真实来源；日常运行保持 0。
EASY_HOSPITAL_DISABLE_LIVE_SOURCES=0

# 实验性 Browser Agent 默认关闭。启用时请生成至少 32 字节的随机配对 token，
# 并在 browser-extension 的选项页保存同一值；不要复用医院密码或会话 Token。
EASY_HOSPITAL_BROWSER_AGENT_TOKEN=

# 所有成功配置的通知渠道都会发送。未配置时仍可在通知记录页检查待发送内容。
# Bark: 从 Bark App 获取设备 key。
BARK_BASE_URL=https://api.day.app
BARK_DEVICE_KEY=

# SMTP: 可选；设置后启用邮件通知。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
